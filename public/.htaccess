<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preserve each path while consolidating legacy and www hosts on sns.com.sa.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?nationalsol\.(?:com|sa)$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.sns\.com\.sa$ [NC]
  RewriteRule ^ https://sns.com.sa%{REQUEST_URI} [R=301,L,NE]

  # Serve crawler-ready Blog HTML without changing the public canonical URLs.
  RewriteRule ^blog/?$ /prerender/blog.html [L]
  RewriteCond %{DOCUMENT_ROOT}/prerender/blog/$1.html -f
  RewriteRule ^blog/([^/]+)/?$ /prerender/blog/$1.html [L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
