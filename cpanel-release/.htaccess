<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Consolidate search authority on the canonical apex domain.
  RewriteCond %{HTTP_HOST} ^www\.nationalsol\.sa$ [NC]
  RewriteRule ^ https://nationalsol.sa%{REQUEST_URI} [R=301,L,NE]

  # Serve crawler-ready Blog HTML without changing the public canonical URLs.
  RewriteRule ^blog/?$ /prerender/blog.html [L]
  RewriteCond %{DOCUMENT_ROOT}/prerender/blog/$1.html -f
  RewriteRule ^blog/([^/]+)/?$ /prerender/blog/$1.html [L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
